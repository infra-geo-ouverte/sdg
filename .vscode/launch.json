{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "serve Demo",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/"
    },
    {
      "name": "serve Demo (editor)",
      "type": "editor-browser",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/"
    },
    {
      "name": "test",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: test.watch",
      "url": "http://localhost:9876/debug.html"
    },
    {
      "name": "serve Client",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "client/start",
      "url": "http://localhost:4210",
      "webRoot": "${workspaceFolder}/projects/client",
      "sourceMaps": true
    }
  ]
}
